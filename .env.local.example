# Local: the URL below already matches this repo's supabase/config.toml (the
# [api] port there is 54421, not the Supabase CLI default of 54321 — see the
# comment above [api] in that file for why). You only need to replace the
# key. Run `supabase status -o env` and copy its ANON_KEY as the value below;
# if the URL ever stops matching (e.g. someone changes the port in
# config.toml), copy API_URL from that same output too.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me

# Used by the integration suite (src/test/integration) and by scripts that
# talk to Postgres directly. Also from `supabase status -o env`: SUPABASE_URL
# <- API_URL, SUPABASE_PUBLISHABLE_KEY <- ANON_KEY (or PUBLISHABLE_KEY on
# newer CLI output), SUPABASE_SERVICE_ROLE_KEY <- SERVICE_ROLE_KEY (or
# SECRET_KEY), SUPABASE_DB_URL <- DB_URL. A fresh clone cannot run
# `npm run test:integration` without these.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_DB_URL=replace-me
