# Copy to .env.local for `npm run dev`. Set the same names in Vercel
# (Project → Settings → Environment Variables) with the production values.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Claude, for reading uploaded purchase invoices
ANTHROPIC_API_KEY=

# Cloudflare D1 (database), reached over Cloudflare's HTTP API.
# Token: dash.cloudflare.com → My Profile → API Tokens → Create, with the
# "D1: Edit" permission on this account.
CLOUDFLARE_ACCOUNT_ID=f210ee7ef36638fbe0ee7064b3b775a4
CLOUDFLARE_D1_TOKEN=
# Local development: invoicer-dev. Production (Vercel): invoicer. Ids are in wrangler.jsonc.
CLOUDFLARE_DATABASE_ID=a18617c1-fe17-4501-b3ca-0994bcd8b5b9

# Cloudflare R2 (uploaded files), reached over its S3-compatible API.
# Keys: dash.cloudflare.com → R2 → Manage API Tokens → Create, "Object Read & Write".
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Local development: invoicer-files-dev. Production (Vercel): invoicer-files.
R2_BUCKET=invoicer-files-dev
